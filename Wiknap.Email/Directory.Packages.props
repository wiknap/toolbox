<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>
    <ItemGroup>
        <PackageVersion Include="Bogus" Version="35.6.5"/>
        <PackageVersion Include="JetBrains.Annotations" Version="2026.2.0"/>
        <PackageVersion Include="MailKit" Version="4.17.0"/>
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0"/>
        <PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.9.0"/>
        <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11"/>
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0"/>
        <PackageVersion Include="Microsoft.Testing.Extensions.VSTestBridge" Version="2.3.3"/>
        <PackageVersion Include="NSubstitute" Version="6.2.0"/>
        <PackageVersion Include="OpenTelemetry.Api" Version="1.17.0"/>
        <PackageVersion Include="OpenTelemetry.Api.ProviderBuilderExtensions" Version="1.17.0"/>
        <PackageVersion Include="Scrutor" Version="7.0.0"/>
        <PackageVersion Include="Shouldly" Version="4.3.0"/>
        <PackageVersion Include="Wiknap.Email" Version="2.0.38"/>
        <PackageVersion Include="Wiknap.Testcontainers.MailServer" Version="1.0.33"/>
        <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageVersion>
        <PackageVersion Include="xunit.v3" Version="3.2.2"/>
    </ItemGroup>
</Project>
